{
  "title": "Urban RAG — Quality Dashboard",
  "uid": "urban-rag-quality",
  "version": 1,
  "refresh": "5m",
  "panels": [
    {
      "title": "Retrieval Candidates per Query (avg)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
      "targets": [
        {
          "expr": "sum(rate(retrieval_candidates_sum[5m])) / sum(rate(retrieval_candidates_count[5m]))",
          "legendFormat": "avg candidates",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Query Latency by Status — p95",
      "type": "timeseries",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 6},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(query_latency_seconds_bucket[5m])) by (le, status))",
          "legendFormat": "{{status}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Token Usage — Prompt vs Output",
      "type": "timeseries",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 6},
      "targets": [
        {
          "expr": "sum(rate(tokens_total{token_type=\"prompt\"}[1h]))",
          "legendFormat": "prompt tokens/hr",
          "refId": "A"
        },
        {
          "expr": "sum(rate(tokens_total{token_type=\"output\"}[1h]))",
          "legendFormat": "output tokens/hr",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Query Volume by Mode",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 6, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "sum(increase(query_total[1h])) by (mode)",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Qdrant Channel Latency — p50",
      "type": "timeseries",
      "gridPos": {"x": 6, "y": 6, "w": 8, "h": 6},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(qdrant_latency_seconds_bucket[5m])) by (le, channel))",
          "legendFormat": "{{channel}} p50",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Generation Cost by Mode",
      "type": "timeseries",
      "gridPos": {"x": 14, "y": 6, "w": 10, "h": 6},
      "targets": [
        {
          "expr": "sum(increase(cost_usd_total[1h])) by (mode)",
          "legendFormat": "{{mode}} cost/hr",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Answer Confidence Distribution",
      "type": "piechart",
      "gridPos": {"x": 0, "y": 12, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "sum(query_total) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Success vs Error vs Refused Rate",
      "type": "timeseries",
      "gridPos": {"x": 6, "y": 12, "w": 9, "h": 6},
      "targets": [
        {
          "expr": "sum(rate(query_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Query Latency Heatmap",
      "type": "heatmap",
      "gridPos": {"x": 15, "y": 12, "w": 9, "h": 6},
      "targets": [
        {
          "expr": "sum(rate(query_latency_seconds_bucket[5m])) by (le)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 38
}
