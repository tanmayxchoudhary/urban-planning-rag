{
  "title": "Urban RAG — Operator Dashboard",
  "uid": "urban-rag-operator",
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "title": "Query Rate (queries/min)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
      "targets": [
        {
          "expr": "sum(rate(query_total[1m])) by (mode)",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Query Latency — p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 6},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(query_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(query_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(query_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Error Rate by Status",
      "type": "timeseries",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 6},
      "targets": [
        {
          "expr": "sum(rate(query_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Qdrant Retrieval Latency — p95 by Channel",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 6},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(qdrant_latency_seconds_bucket[5m])) by (le, channel))",
          "legendFormat": "{{channel}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Total Cost (USD) — Rolling",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 6, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "sum(increase(cost_usd_total[1h]))",
          "legendFormat": "cost/hr",
          "refId": "A"
        },
        {
          "expr": "sum(rate(cost_usd_total[1h])) / sum(rate(query_total[1h]))",
          "legendFormat": "cost/query",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": [{"item": {"legendFormat": "cost/query", "unit": "currencyUSD"}}]
        }
      }
    },
    {
      "title": "Query Latency Distribution (Buckets)",
      "type": "histogram",
      "gridPos": {"x": 18, "y": 6, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "sum(rate(query_latency_seconds_bucket[5m])) by (le)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Scrape Target Health",
      "type": "stat",
      "gridPos": {"x": 0, "y": 12, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "up{job=~\"urban-rag-.*\"}",
          "refId": "A"
        }
      ],
      "options": {"colorMode": "value", "graphMode": "none"},
      "fieldConfig": {
        "defaults": {
          "mappings": [{"options": {"0": {"text": "DOWN", "color": "red"}}, "1": {"text": "UP", "color": "green"}}}],
          "thresholds": {"steps": [{"value": 0, "color": "red"}, {"value": 1, "color": "green"}]}
        }
      }
    },
    {
      "title": "Query Throughput (last 15 min)",
      "type": "timeseries",
      "gridPos": {"x": 6, "y": 12, "w": 9, "h": 4},
      "targets": [
        {
          "expr": "sum(increase(query_total[1m]))",
          "legendFormat": "queries/min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Cost per Query (USD)",
      "type": "gauge",
      "gridPos": {"x": 15, "y": 12, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "sum(rate(cost_usd_total[1h])) / sum(rate(query_total[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "max": 0.10,
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 0.03, "color": "yellow"},
              {"value": 0.05, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "title": "5xx Error Rate",
      "type": "gauge",
      "gridPos": {"x": 19, "y": 12, "w": 5, "h": 4},
      "targets": [
        {
          "expr": "sum(rate(query_total{status=~\"5..\"}[5m])) / sum(rate(query_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.05,
          "thresholds": {
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 0.001, "color": "yellow"},
              {"value": 0.01, "color": "red"}
            ]
          }
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 38
}
